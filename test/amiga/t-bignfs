; Large-file NFS round trip: Copy DH0:PrismNet/big1g.bin (make it on the PC)
; to the NFS share and back to DH0:PrismNet/big1g.back; compare MD5s on the
; PC and on the NAS afterwards.
FailAt 21
Copy DH0:PrismNet/cfg/dhcp ENV:PrismNet ALL QUIET
C:PrismNet START
Wait 6
Mount DH0:PrismNet/nfs/PN0
Echo "start" >DH0:PrismNet/big-nfs.log
Date >>DH0:PrismNet/big-nfs.log
Copy DH0:PrismNet/big1g.bin PN0:pn-big1g.bin >>DH0:PrismNet/big-nfs.log
Echo "written" >>DH0:PrismNet/big-nfs.log
Date >>DH0:PrismNet/big-nfs.log
Copy PN0:pn-big1g.bin DH0:PrismNet/big1g.back >>DH0:PrismNet/big-nfs.log
Date >>DH0:PrismNet/big-nfs.log
Echo "DONE" >>DH0:PrismNet/big-nfs.log
